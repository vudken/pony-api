<div class="container-fluid">
    <div class="row">
        <!-- Calendar Section -->
        <div class="col-lg-9">
            <div class="calendar-card bg-dark p-4 rounded">
                <div id="calendar" class="p-3"></div> <!-- ✅ The calendar will render here -->
            </div>
        </div>

        <div class="col-lg-3">
            <div class="event-list p-3 rounded bg-dark">
                <h5 class="text-light">Production Stages</h5>
                <ul id="stage-list" class="list-unstyled text-white">
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- MODAL BACKDROP -->
<div id="addStageModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h4 class="modal-title">Set Start Date for Stages</h4>

        <!-- 🚀 Date Picker -->
        <label for="selected-date">Select Date:</label>
        <input type="date" id="selected-date" class="form-control">

        <!-- 🚀 Stage Selection (Custom Clickable List) -->
        <label>Select Stages:</label>
        <div id="stage-selection-container" class="stage-list-container">
            <!-- Stages will be dynamically populated here -->
        </div>

        <!-- 🚀 Submit Button -->
        <button id="confirmStartDate" class="btn btn-primary mt-3">Confirm</button>
    </div>
</div>

<script src="assets/js/calendar.js"></script>